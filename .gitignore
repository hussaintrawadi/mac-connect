# --- macOS ---
.DS_Store
**/.DS_Store

# --- Build outputs / artifacts ---
dist/
*.apk
*.dmg
*.ipa

# --- Android ---
AndroidApp/.gradle/
AndroidApp/.kotlin/
AndroidApp/build/
AndroidApp/app/build/
AndroidApp/app/.cxx/
AndroidApp/local.properties
