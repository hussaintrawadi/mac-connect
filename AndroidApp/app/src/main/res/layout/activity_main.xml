<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <!-- Branded logo backdrop -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_logo_glow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Mac Connect logo" />

        </FrameLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mac Connect"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:textColor="@color/on_surface"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="18dp" />

        <!-- Status pill: dot + text -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_qr_frame"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_status"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Connection status card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/statusPill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/cardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/cardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No device paired"
                    android:textSize="15sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Now Playing card (phone) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mediaCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/statusCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING ON PHONE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/mediaTrack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/mediaArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <ImageButton
                        android:id="@+id/mediaPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_previous"
                        android:tint="@color/on_surface"
                        android:contentDescription="Previous" />

                    <ImageButton
                        android:id="@+id/mediaPlayPause"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_play"
                        android:tint="@color/on_surface"
                        android:contentDescription="Play/Pause" />

                    <ImageButton
                        android:id="@+id/mediaNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_next"
                        android:tint="@color/on_surface"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mac controls card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/macCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/mediaCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/macTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mac"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/macBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Battery —"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <!-- Mac control panel: Volume / Brightness / Wi-Fi / Bluetooth -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/macVolumeButton"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Volume"
                        android:textColor="@color/on_surface"
                        app:icon="@drawable/ic_ctl_volume"
                        app:iconTint="@color/on_surface"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/macBrightnessButton"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Brightness"
                        android:textColor="@color/on_surface"
                        app:icon="@drawable/ic_ctl_brightness"
                        app:iconTint="@color/on_surface"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/macWifiButton"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Wi-Fi"
                        android:textColor="@color/on_surface"
                        app:icon="@drawable/ic_ctl_wifi"
                        app:iconTint="@color/on_surface"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/macBluetoothButton"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Bluetooth"
                        android:textColor="@color/on_surface"
                        app:icon="@drawable/ic_ctl_bluetooth"
                        app:iconTint="@color/on_surface"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lockMacButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:text="Lock"
                        android:textColor="@color/on_surface"
                        app:cornerRadius="12dp"
                        app:rippleColor="@color/surface_elevated" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/findMacButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:text="Find Mac"
                        android:textColor="@color/on_surface"
                        app:cornerRadius="12dp"
                        app:rippleColor="@color/surface_elevated" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mac now-playing card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/macMediaCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/macCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING ON MAC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/macMediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="On Mac"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/macMediaArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <ImageButton
                        android:id="@+id/macMediaPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_previous"
                        android:tint="@color/on_surface"
                        android:contentDescription="Previous" />

                    <ImageButton
                        android:id="@+id/macMediaPlayPause"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_play"
                        android:tint="@color/on_surface"
                        android:contentDescription="Play/Pause" />

                    <ImageButton
                        android:id="@+id/macMediaNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_icon_button"
                        android:src="@android:drawable/ic_media_next"
                        android:tint="@color/on_surface"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mirrorButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="Start Mirroring"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:visibility="gone"
            app:backgroundTint="@color/surface"
            app:strokeWidth="0dp"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconTint="@color/on_surface"
            app:iconGravity="textStart"
            app:rippleColor="@color/surface_elevated"
            app:layout_constraintTop_toBottomOf="@id/macMediaCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Primary action once paired: Connect / Disconnect -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectionToggleButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Disconnect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/mirrorButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/connectionHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Disconnecting keeps the pairing — tap the same button to reconnect later. No QR scan needed."
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/connectionToggleButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Pair with Mac"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_qr_illustration"
            app:iconTint="@color/on_primary"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/connectionHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
